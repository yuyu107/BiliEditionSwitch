{
  "manifest_version": 2,
  "name": "B站国内版 / 国际版切换",
  "version": "0.1.1",
  "description": "点击工具栏按钮切换 bilibili.com 国内版与国际多语言版，并设置国际版默认语言。",
  "permissions": ["activeTab", "storage", "menus"],
  "background": {"scripts": ["shared.js", "background.js"], "persistent": false},
  "browser_action": {
    "default_title": "切换 B站国内版 / 国际版（右键可设置语言）",
    "default_icon": {"32": "icons/switch.svg"}
  },
  "icons": {"48": "icons/switch.svg", "96": "icons/switch.svg"},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {"default": "Alt+Shift+B"},
      "description": "切换 B站国内版 / 国际版"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bili-edition-switch@yuyu107.local",
      "strict_min_version": "78.0",
      "data_collection_permissions": {"required": ["none"]}
    }
  }
}
